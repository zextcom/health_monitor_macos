<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle's Installer/Downloader XPC services are signed with Sparkle's own certificate,
	     not ours — Hardened Runtime's library validation refuses to load them from our app
	     unless validation is disabled. Required for notarization once Hardened Runtime is on;
	     see https://sparkle-project.org/documentation/#hardened-runtime-and-notarization -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Enables NSUbiquitousKeyValueStore for opt-in endpoint-list sync across the user's own
	     Macs (see EndpointStore's iCloud sync layer). Does not require the CloudKit container
	     also registered on the App ID — that's for full CloudKit record sync, unused here. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
